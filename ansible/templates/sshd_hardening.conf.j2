# Network & Authentication
Port {{ custom_ssh_port | default(60022) }}
Banner {{ ssh_banner | default('/etc/issue.net') }}
LogLevel VERBOSE
AllowGroups {{ ssh_allowed_groups | default('sudo') }}
PermitRootLogin {{ ssh_permit_root_login | default('no') }}
PasswordAuthentication no
PubkeyAuthentication yes
KbdInteractiveAuthentication no
UsePAM yes

# Session & Rate Limits
MaxAuthTries 3
MaxSessions 2
LoginGraceTime 30
MaxStartups 10:30:60

# Keepalive & Timeouts
ClientAliveInterval 300
ClientAliveCountMax 2
ChannelTimeout session=30m
TCPKeepAlive no

# Forwarding Hardening
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no

# Cryptographic Protocol Hardening
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256
